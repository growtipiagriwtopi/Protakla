local function stepESP()
	if not cfg.esp then return end
	syncESPList()
	local camPos = camera.CFrame.Position
	for p, item in pairs(espMap) do
		if not validPlayerChar(p) or p.Character ~= item.char then
			clearESPForPlayer(p)
		else
			local m = p.Character
			local root = m:FindFirstChild("HumanoidRootPart")
			local head = m:FindFirstChild("Head")
			local vis = cfg.wallCheck or canSee(root, m)
			item.box.Visible = vis
			item.box.AlwaysOnTop = cfg.wallCheck
			item.box.Adornee = root

			local meters = math.floor((root.Position - camPos).Magnitude * 0.28 + 0.5)
			item.lbl.Text = p.DisplayName .. " | " .. meters .. "m"
			item.tag.Enabled = vis
			item.tag.AlwaysOnTop = cfg.wallCheck
			item.tag.Adornee = head

			local idx = 1
			for _, pair in ipairs(boneLinks) do
				local p0, p1 = m:FindFirstChild(pair[1]), m:FindFirstChild(pair[2])
				if p0 and p1 and p0:IsA("BasePart") and p1:IsA("BasePart") then
					local bone = item.bones[idx]
					if bone then
						local a, b = p0.Position, p1.Position
						local len = (b - a).Magnitude
						if len > 0.02 then
							bone.CFrame = CFrame.lookAt((a + b) * 0.5, b) * CFrame.Angles(math.pi / 2, 0, 0)
							bone.Height = len
							bone.Visible = vis
							bone.AlwaysOnTop = cfg.wallCheck
						else
							bone.Visible = false
						end
						idx += 1
					end
				end
			end
		end
	end
end

local function getTargetHead()
	local cf = camera.CFrame
	local bestPart, bestDist = nil, math.huge
	local halfRad = math.rad(math.clamp(cfg.fov, 10, 360) * 0.5)
	for _, p in ipairs(Players:GetPlayers()) do
		if validPlayerChar(p) then
			local m = p.Character
			local head = m:FindFirstChild("Head")
			local delta = head.Position - cf.Position
			local dist = delta.Magnitude
			if dist > 0.1 then
				local ang = math.acos(math.clamp(cf.LookVector:Dot(delta.Unit), -1, 1))
				if (cfg.fov >= 359.5 or ang <= halfRad) and canSee(head, m) and dist < bestDist then
					bestDist = dist
					bestPart = head
				end
			end
		end
	end
	return bestPart
end

local function stepAimbot()
	if not cfg.aimbot then return end
	local head = getTargetHead()
	if not head then return end
	camera.CFrame = CFrame.lookAt(camera.CFrame.Position, head.Position)
end

