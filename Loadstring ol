serverScript.Source = [[
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remotes = ReplicatedStorage:WaitForChild("FreemiumV5Remotes")
local event = remotes:WaitForChild("UpdateMovementEvent")

local states = {}

local function getState(player)
	if not states[player] then
		states[player] = {
			speedEnabled = false,
			speedValue = 57,
			jumpEnabled = false,
			jumpValue = 69,
			spinEnabled = false,
			spinValue = 12,
		}
	end
	return states[player]
end

local function clearSpin(character)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local av = root:FindFirstChild("FreemiumSpinAV")
	if av then av:Destroy() end
	local att = root:FindFirstChild("FreemiumSpinAtt")
	if att then att:Destroy() end
end

local function applyCharacter(player, character)
	local st = getState(player)
	local hum = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not hum or not root then return end

	hum.WalkSpeed = st.speedEnabled and math.clamp(st.speedValue, 0, 250) or 16
	hum.UseJumpPower = true
	hum.JumpPower = st.jumpEnabled and math.clamp(st.jumpValue, 0, 300) or 50

	clearSpin(character)
	if st.spinEnabled then
		local att = Instance.new("Attachment")
		att.Name = "FreemiumSpinAtt"
		att.Parent = root

		local av = Instance.new("AngularVelocity")
		av.Name = "FreemiumSpinAV"
		av.Attachment0 = att
		av.MaxTorque = 1e6
		av.AngularVelocity = Vector3.new(0, math.clamp(st.spinValue, 0, 120), 0)
		av.RelativeTo = Enum.ActuatorRelativeTo.World
		av.Parent = root
	end
end

event.OnServerEvent:Connect(function(player, data)
	if typeof(data) ~= "table" then return end
	local st = getState(player)
	if typeof(data.speedEnabled) == "boolean" then st.speedEnabled = data.speedEnabled end
	if typeof(data.speedValue) == "number" then st.speedValue = math.clamp(data.speedValue, 1, 250) end
	if typeof(data.jumpEnabled) == "boolean" then st.jumpEnabled = data.jumpEnabled end
	if typeof(data.jumpValue) == "number" then st.jumpValue = math.clamp(data.jumpValue, 1, 300) end
	if typeof(data.spinEnabled) == "boolean" then st.spinEnabled = data.spinEnabled end
	if typeof(data.spinValue) == "number" then st.spinValue = math.clamp(data.spinValue, 0, 120) end

	if player.Character then
		applyCharacter(player, player.Character)
	end
end)

Players.PlayerAdded:Connect(function(player)
	getState(player)
	player.CharacterAdded:Connect(function(char)
		applyCharacter(player, char)
	end)
end)

for _, player in ipairs(Players:GetPlayers()) do
	getState(player)
	if player.Character then
		applyCharacter(player, player.Character)
	end
	player.CharacterAdded:Connect(function(char)
		applyCharacter(player, char)
	end)
end

Players.PlayerRemoving:Connect(function(player)
	states[player] = nil
end)
]]
serverScript.Parent = ServerScriptService

