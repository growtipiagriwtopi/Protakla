local event = ReplicatedStorage:WaitForChild("FreemiumV5Remotes"):WaitForChild("UpdateMovementEvent")

local cfg = {
	esp = false,
	wallCheck = true,
	aimbot = false,
	fov = 120,
	speedOn = false,
	speed = 57,
	jumpOn = false,
	jump = 69,
	spinOn = false,
	spin = 12,
}

local function validPlayerChar(targetPlayer)
	if not targetPlayer or targetPlayer == player then return false end
	local m = targetPlayer.Character
	if not m or not m:IsA("Model") then return false end
	local hum = m:FindFirstChildOfClass("Humanoid")
	local head = m:FindFirstChild("Head")
	local root = m:FindFirstChild("HumanoidRootPart")
	return hum and head and root and head:IsA("BasePart") and root:IsA("BasePart") and hum.Health > 0
end

local function canSee(part, charModel)
	local origin = camera.CFrame.Position
	local dir = part.Position - origin
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list = { charModel }
	if player.Character then table.insert(list, player.Character) end
	params.FilterDescendantsInstances = list
	return Workspace:Raycast(origin, dir, params) == nil
end

local function pushMovement()
	event:FireServer({
		speedEnabled = cfg.speedOn,
		speedValue = cfg.speed,
		jumpEnabled = cfg.jumpOn,
		jumpValue = cfg.jump,
		spinEnabled = cfg.spinOn,
		spinValue = cfg.spin,
	})
end

local espMap = {}
local espContainer = Instance.new("Folder")
espContainer.Name = "FreemiumESP"
espContainer.Parent = playerGui

local boneLinks = {
	{"Head", "UpperTorso"}, {"Head", "Torso"},
	{"UpperTorso", "LowerTorso"},
	{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
	{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
	{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
	{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
	{"Torso", "Left Arm"}, {"Torso", "Right Arm"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}

local function clearESPForPlayer(p)
	local item = espMap[p]
	if not item then return end
	for _, c in ipairs(item.conns) do c:Disconnect() end
	if item.box then item.box:Destroy() end
	for _, b in ipairs(item.bones) do b:Destroy() end
	if item.tag then item.tag:Destroy() end
	espMap[p] = nil
end

local function clearAllESP()
	for p in pairs(espMap) do clearESPForPlayer(p) end
end

local function addESPForPlayer(p)
	if espMap[p] or not validPlayerChar(p) then return end
	local m = p.Character
	local root = m:FindFirstChild("HumanoidRootPart")
	local head = m:FindFirstChild("Head")
	local hum = m:FindFirstChildOfClass("Humanoid")

	local box = Instance.new("BoxHandleAdornment")
	box.Adornee = root
	box.Size = Vector3.new(4, 5.5, 2.5)
	box.Color3 = Color3.fromRGB(255, 255, 255)
	box.Transparency = 0.55
	box.AlwaysOnTop = cfg.wallCheck
	box.ZIndex = 5
	box.Parent = espContainer

	local bones = {}
	for _, pair in ipairs(boneLinks) do
		local p0, p1 = m:FindFirstChild(pair[1]), m:FindFirstChild(pair[2])
		if p0 and p1 and p0:IsA("BasePart") and p1:IsA("BasePart") then
			local bone = Instance.new("CylinderHandleAdornment")
			bone.Adornee = Workspace.Terrain
			bone.Color3 = Color3.fromRGB(168, 85, 247)
			bone.Transparency = 0.15
			bone.Radius = 0.06
			bone.Height = 1
			bone.AlwaysOnTop = cfg.wallCheck
			bone.ZIndex = 6
			bone.Parent = espContainer
			table.insert(bones, bone)
		end
	end

	local tag = Instance.new("BillboardGui")
	tag.Adornee = head
	tag.Size = UDim2.new(0, 130, 0, 26)
	tag.StudsOffset = Vector3.new(0, 2.2, 0)
	tag.AlwaysOnTop = cfg.wallCheck
	tag.Parent = espContainer

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.BackgroundColor3 = Color3.fromRGB(15, 10, 25)
	lbl.BackgroundTransparency = 0.35
	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 12
	lbl.Parent = tag
	Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 6)

	local conns = {
		hum.Died:Connect(function() clearESPForPlayer(p) end),
		p.CharacterRemoving:Connect(function() clearESPForPlayer(p) end),
	}

	espMap[p] = { char = m, box = box, bones = bones, tag = tag, lbl = lbl, conns = conns }
end

local function syncESPList()
	if not cfg.esp then clearAllESP() return end
	for _, p in ipairs(Players:GetPlayers()) do
		if validPlayerChar(p) then
			addESPForPlayer(p)
		end
	end
end

Players.PlayerAdded:Connect(function(p)
	if p == player then return end
	p.CharacterAdded:Connect(function()
		task.wait(0.05)
		if cfg.esp and validPlayerChar(p) then
