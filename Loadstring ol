	btn.Font = Enum.Font.GothamBlack
	btn.TextSize = 13
	btn.Parent = row
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	local active = initVal
	local function paint()
		if active then
			btn.Text = "ON"
			btn.BackgroundColor3 = Color3.fromRGB(20, 83, 45)
			btn.TextColor3 = Color3.fromRGB(134, 239, 172)
			dot.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
		else
